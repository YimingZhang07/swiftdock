<Window x:Class="QuickLaunch.Views.EditItemDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="NameBox" Margin="0,6,0,16" MaxLength="160" />
        <TextBlock Text="程序、文件、文件夹或 http/https 网址" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="PathBox" Margin="0,6,0,8" TextChanged="PathChanged" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="选择文件…" Click="ChooseFile" Margin="0,0,8,0" /><Button Content="选择文件夹…" Click="ChooseFolder" />
        </StackPanel>
        <TextBlock Text="启动参数（快捷方式使用其自身参数）" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="ArgumentsBox" Margin="0,6,0,16" />
        <TextBlock Text="工作目录（可留空）" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
        <TextBox x:Name="WorkingBox" Margin="0,6,0,16" />
        <CheckBox x:Name="ElevateBox" Content="以管理员身份启动此应用" Margin="0,0,0,16" />
        <TextBlock x:Name="Error" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource AccentButton}" IsDefault="True" Click="SaveClick" Margin="0,0,8,0" /><Button Content="取消" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
