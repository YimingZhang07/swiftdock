<ui:FluentWindow x:Class="QuickLaunch.Views.EditItemDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickLaunch.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:QuickLaunch.Models" xmlns:services="clr-namespace:QuickLaunch.Services"
        Title="{Binding Title}" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" PreviewKeyDown="EditorKeyDown">
    <ui:FluentWindow.Resources>
        <views:SelectionConverter x:Key="Selection" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="TypeCard" TargetType="RadioButton" BasedOn="{StaticResource IconSizeSegment}">
            <Setter Property="Height" Value="64" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="6" />
                    <Border x:Name="Hover" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Opacity="0" />
                    <Border x:Name="Tint" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="6" Opacity="0" />
                    <Border x:Name="Outline" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <Setter TargetName="Outline" Property="BorderThickness" Value="1.5" />
                        <Setter TargetName="Tint" Property="Opacity" Value="0.1" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LocationChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="9,4" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="IconPickerLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" /><Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="4,6" />
        </Style>
        <Style x:Key="IconChoice" TargetType="RadioButton">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border x:Name="Ring" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8" Margin="1" />
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
    <ui:TitleBar x:Name="DialogTitleBar" DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                 Icon="{x:Null}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />
    <Grid>
    <StackPanel Margin="24,12,24,24">
        <StackPanel x:Name="EditorBody" IsEnabled="{Binding IsEditing}">
            <Grid x:Name="TypeCards" Margin="0,0,0,20" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="TypeKeyDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /><ColumnDefinition Width="8" />
                    <ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="AppCard" Grid.Column="0" Content="&#xE71D;" AutomationProperties.Name="应用" Tag="{x:Static models:LaunchKind.App}" IsChecked="{Binding SelectedKind, Converter={StaticResource Selection}, ConverterParameter={x:Static models:LaunchKind.App}}" GroupName="ItemType" Style="{StaticResource TypeCard}" Command="{Binding SelectTypeCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <RadioButton x:Name="FileCard" Grid.Column="2" Content="&#xE8A5;" AutomationProperties.Name="文件" Tag="{x:Static models:LaunchKind.File}" IsChecked="{Binding SelectedKind, Converter={StaticResource Selection}, ConverterParameter={x:Static models:LaunchKind.File}}" GroupName="ItemType" Style="{StaticResource TypeCard}" Command="{Binding SelectTypeCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <RadioButton x:Name="FolderCard" Grid.Column="4" Content="&#xE8B7;" AutomationProperties.Name="文件夹" Tag="{x:Static models:LaunchKind.Folder}" IsChecked="{Binding SelectedKind, Converter={StaticResource Selection}, ConverterParameter={x:Static models:LaunchKind.Folder}}" GroupName="ItemType" Style="{StaticResource TypeCard}" Command="{Binding SelectTypeCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <RadioButton x:Name="UrlCard" Grid.Column="6" Content="&#xE774;" AutomationProperties.Name="网址" Tag="{x:Static models:LaunchKind.Url}" IsChecked="{Binding SelectedKind, Converter={StaticResource Selection}, ConverterParameter={x:Static models:LaunchKind.Url}}" GroupName="ItemType" Style="{StaticResource TypeCard}" Command="{Binding SelectTypeCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            </Grid>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button x:Name="IconPreview" Width="56" Height="56" MinWidth="0" Padding="0" ToolTip="更换图标" AutomationProperties.Name="更换图标" Command="{Binding OpenIconPickerCommand}">
                    <Button.Template><ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <Border x:Name="EditBadge" Background="{DynamicResource TextFillColorPrimaryBrush}" CornerRadius="8" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource ApplicationBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EditBadge" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EditBadge" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Button.Template>
                    <Grid>
                        <TextBlock x:Name="PreviewGlyph" Text="{Binding PreviewGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Image x:Name="PreviewImage" Width="40" Height="40" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Button>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox x:Name="NameBox" PlaceholderText="名称" Margin="0,6,0,0" MaxLength="160" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="名称" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TargetLabel" Text="{Binding TargetLabel}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid>
                    <ui:TextBox x:Name="PathBox" PlaceholderText="{Binding TargetPlaceholder}" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Text, ElementName=TargetLabel}" InputMethod.PreferredImeState="Off" />
                    <!-- Keep the named hint as the URL placeholder source; TextBox renders it. -->
                    <TextBlock x:Name="UrlHint" Text="https://" Visibility="Collapsed" />
                </Grid>
                <ui:Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Command="{Binding BrowseCommand}" Visibility="{Binding CanBrowse, Converter={StaticResource Visible}}" Margin="8,0,0,0" />
            </Grid>
            <!-- One 54-DIP collapsed slot: 20-DIP header + 32 padding + 2 border.
                 Only an explicitly expanded App expander can grow this row. -->
            <Grid x:Name="TypeArea" Margin="0,16,0,0" ClipToBounds="True">
                <Grid.Style><Style TargetType="Grid">
                    <Setter Property="Height" Value="54" />
                    <Style.Triggers><MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsApplication}" Value="True" />
                            <Condition Binding="{Binding AdvancedExpanded}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Height" Value="Auto" />
                    </MultiDataTrigger></Style.Triggers>
                </Style></Grid.Style>
            <StackPanel x:Name="LocationChips" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding IsFolder, Converter={StaticResource Visible}}">
                <TextBlock Text="常用位置" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="桌面" Tag="{x:Static services:CommonLocation.Desktop}" Style="{StaticResource LocationChip}" Command="{Binding SelectLocationCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <Button Content="下载" Tag="{x:Static services:CommonLocation.Downloads}" Style="{StaticResource LocationChip}" Command="{Binding SelectLocationCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <Button Content="文档" Tag="{x:Static services:CommonLocation.Documents}" Style="{StaticResource LocationChip}" Command="{Binding SelectLocationCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <Button Content="图片" Tag="{x:Static services:CommonLocation.Pictures}" Style="{StaticResource LocationChip}" Command="{Binding SelectLocationCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                <Button Content="用户目录" Tag="{x:Static services:CommonLocation.Profile}" Style="{StaticResource LocationChip}" Command="{Binding SelectLocationCommand}" CommandParameter="{Binding Tag, RelativeSource={RelativeSource Self}}" Margin="0" />
            </StackPanel>
            <TextBlock Text="使用系统默认程序打开该文件。" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding IsFile, Converter={StaticResource Visible}}" />
            <TextBlock x:Name="UrlDescription" VerticalAlignment="Top" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding IsUrl, Converter={StaticResource Visible}}" />
            <ui:CardExpander x:Name="AdvancedOptions" IsExpanded="{Binding AdvancedExpanded}" Visibility="{Binding IsApplication, Converter={StaticResource Visible}}" VerticalAlignment="Top" Padding="14,16" ContentPadding="16">
                <ui:CardExpander.Header><TextBlock Text="高级选项" Height="20" /></ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock x:Name="ShortcutHint" Text="快捷方式使用自身的参数和工作目录。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" Visibility="{Binding IsShortcut, Converter={StaticResource Visible}}" />
                    <TextBlock Text="启动参数" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox x:Name="ArgumentsBox" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSetArguments}" PlaceholderText="启动参数" Margin="0,6,0,12" AutomationProperties.Name="启动参数" InputMethod.PreferredImeState="Off" />
                    <TextBlock Text="工作目录" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox x:Name="WorkingBox" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSetArguments}" PlaceholderText="工作目录" Margin="0,6,0,16" AutomationProperties.Name="工作目录" InputMethod.PreferredImeState="Off" />
                    <CheckBox x:Name="ElevateBox" IsChecked="{Binding RunAsAdmin}" IsEnabled="{Binding IsApplication}" Content="以管理员身份运行" />
                </StackPanel>
            </ui:CardExpander>
            </Grid>
        </StackPanel>
        <TextBlock x:Name="Error" Text="{Binding Error}" ToolTip="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Height="18" TextTrimming="CharacterEllipsis" Margin="0,16,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="SaveButton" Content="{Binding SaveLabel}" Appearance="Primary" IsDefault="True" Command="{Binding SaveCommand}" Margin="0,0,8,0" /><ui:Button Content="取消" IsCancel="True" />
        </StackPanel>
    </StackPanel>
    <Popup x:Name="IconPopup" IsOpen="{Binding IsIconPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=IconPreview}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
           HorizontalOffset="-12" VerticalOffset="-6" Opened="IconPopupOpened">
        <Border x:Name="PickerSurface" Margin="12" Padding="12" CornerRadius="8" Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="PickerKeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.135" /></Border.Effect>
            <StackPanel>
                <TextBlock Text="选择图标" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" Margin="4,0,0,8" />
                <UniformGrid x:Name="IconSeries" Columns="3" Margin="0,0,0,8" KeyboardNavigation.TabNavigation="Once" PreviewKeyDown="SeriesKeyDown">
                    <RadioButton x:Name="SimpleSeries" Content="简约" Tag="0" IsChecked="True" GroupName="IconSeries" Style="{StaticResource IconSizeSegment}" Click="SeriesClicked" />
                    <RadioButton x:Name="SystemSeries" Content="系统" Tag="1" GroupName="IconSeries" Style="{StaticResource IconSizeSegment}" Click="SeriesClicked" />
                    <RadioButton x:Name="ColorSeries" Content="彩色" Tag="2" GroupName="IconSeries" Style="{StaticResource IconSizeSegment}" Click="SeriesClicked" />
                </UniformGrid>
                <!-- One fixed slot. Catalogs use the space occupied by the simple palette. -->
                <Grid x:Name="PickerGridArea" Height="288" Width="304">
                <ScrollViewer x:Name="GlyphScroller" Height="216" VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <UniformGrid x:Name="GlyphGrid" Columns="8" Width="288" HorizontalAlignment="Left" KeyboardNavigation.TabNavigation="Once" PreviewKeyDown="ChoiceKeyDown" />
                </ScrollViewer>
                <ListBox x:Name="CatalogRows" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.CacheLength="0" VirtualizingPanel.ScrollUnit="Item"
                         KeyboardNavigation.TabNavigation="Once" PreviewKeyDown="CatalogKeyDown">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <ItemsControl ItemsSource="{Binding}" Width="288" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <RadioButton Style="{StaticResource IconChoice}" GroupName="CatalogIcon" Background="Transparent"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}" Tag="{Binding Spec}" ToolTip="{Binding Name}"
                                             AutomationProperties.Name="{Binding Name}" AutomationProperties.AutomationId="{Binding Spec}"
                                             Command="{Binding DataContext.SelectCatalogIconCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Spec}">
                                    <Image Width="28" Height="28" Loaded="CatalogImageLoaded" Unloaded="CatalogImageUnloaded" RenderOptions.BitmapScalingMode="HighQuality" />
                                </RadioButton>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="PaletteArea" Height="72" VerticalAlignment="Bottom">
                <TextBlock Text="颜色" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="4,12,0,4" />
                <UniformGrid x:Name="PaletteGrid" Columns="8" Width="288" HorizontalAlignment="Left" KeyboardNavigation.TabNavigation="Once" PreviewKeyDown="ChoiceKeyDown" />
                </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4,10,4,8" />
                <Button x:Name="IconFileButton" Content="从文件选择…" Style="{StaticResource IconPickerLink}" Command="{Binding SelectIconFileCommand}" />
                <Button x:Name="IconResetButton" Content="恢复默认" Style="{StaticResource IconPickerLink}" Command="{Binding ResetIconCommand}" />
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
    </DockPanel>
</ui:FluentWindow>
