<ui:FluentWindow x:Class="QuickLaunch.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickLaunch.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Width="760" Height="540" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowStartupLocation="CenterOwner" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <DockPanel>
        <ui:TitleBar x:Name="DialogTitleBar" DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     Icon="{x:Null}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />
        <ui:Button DockPanel.Dock="Bottom" Content="关闭" HorizontalAlignment="Right" Margin="0,8,20,12" Click="CloseClick" IsCancel="True" />
        <ui:NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Left" OpenPaneLength="152" IsPaneOpen="True"
                           IsPaneToggleVisible="False" IsBackButtonVisible="Collapsed" IsPaneVisible="True" IsFooterSeparatorVisible="False"
                           FrameMargin="0" Transition="None" TransitionDuration="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="常规" TargetPageType="{x:Type views:SettingsGeneralPage}" TargetPageTag="general" AutomationProperties.AutomationId="SettingsGeneralNav" />
                <ui:NavigationViewItem Content="外观" TargetPageType="{x:Type views:SettingsAppearancePage}" TargetPageTag="appearance" AutomationProperties.AutomationId="SettingsAppearanceNav" />
                <ui:NavigationViewItem Content="面板" TargetPageType="{x:Type views:SettingsPanelPage}" TargetPageTag="panel" AutomationProperties.AutomationId="SettingsPanelNav" />
                <ui:NavigationViewItem Content="关于" TargetPageType="{x:Type views:SettingsAboutPage}" TargetPageTag="about" AutomationProperties.AutomationId="SettingsAboutNav" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </DockPanel>
</ui:FluentWindow>
