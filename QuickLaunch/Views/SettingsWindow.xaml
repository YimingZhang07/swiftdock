<ui:FluentWindow x:Class="QuickLaunch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickLaunch.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Width="880" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowStartupLocation="CenterOwner" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <ui:FluentWindow.Resources>
        <views:SelectionConverter x:Key="Selection" />
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource DefaultUiCardControlStyle}">
            <Setter Property="Margin" Value="0,0,0,6" /><Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Margin" Value="2,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Ring" BorderBrush="Transparent" BorderThickness="2" CornerRadius="18" Padding="4" Background="Transparent">
                    <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar x:Name="DialogTitleBar" DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                     Icon="{x:Null}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />
            <Grid DockPanel.Dock="Bottom" Margin="24,0,24,20">
                <ui:Button x:Name="ExitButton" Content="退出 QuickLaunch" Foreground="{DynamicResource SystemFillColorCriticalBrush}" HorizontalAlignment="Left" Command="{Binding ExitCommand}" />
                <ui:Button Content="关闭" HorizontalAlignment="Right" Click="CloseClick" IsCancel="True" />
            </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="24,12,24,24">
            <TextBlock Text="快捷键" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="呼出 / 隐藏面板" />
                        <TextBlock x:Name="Result" Text="{Binding Status}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescription}">
                                <Style.Triggers><DataTrigger Binding="{Binding StatusError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox MinWidth="0" x:Name="Alt" IsChecked="{Binding Alt}" IsEnabled="{Binding CanEdit}" Content="Alt" Margin="0,0,12,0" />
                    <CheckBox MinWidth="0" x:Name="Control" IsChecked="{Binding Control}" IsEnabled="{Binding CanEdit}" Content="Ctrl" Margin="0,0,12,0" />
                    <CheckBox MinWidth="0" x:Name="Shift" IsChecked="{Binding Shift}" IsEnabled="{Binding CanEdit}" Content="Shift" Margin="0,0,12,0" />
                    <CheckBox MinWidth="0" x:Name="Windows" IsChecked="{Binding Windows}" IsEnabled="{Binding CanEdit}" Content="Win" Margin="0,0,16,0" />
                    <ComboBox x:Name="MainKey" ItemsSource="{Binding Keys}" SelectedItem="{Binding MainKey}" IsEnabled="{Binding CanEdit}" Width="100" Margin="0,0,8,0" AutomationProperties.Name="主键" />
                    <ui:Button x:Name="ApplyButton" Content="应用" Appearance="Primary" Command="{Binding ApplyCommand}" />
                </StackPanel>
            </ui:CardControl>
            <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,10" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WeatherMoon24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="主题" /><TextBlock Text="{Binding ThemeDescription}" Style="{StaticResource SettingDescription}" ToolTip="{Binding ThemeDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="ThemeChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="SystemTheme" Content="跟随系统" IsChecked="{Binding Theme, Converter={StaticResource Selection}, ConverterParameter=system}" GroupName="Theme" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="LightTheme" Content="浅色" IsChecked="{Binding Theme, Converter={StaticResource Selection}, ConverterParameter=light}" GroupName="Theme" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="DarkTheme" Content="深色" IsChecked="{Binding Theme, Converter={StaticResource Selection}, ConverterParameter=dark}" GroupName="Theme" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="背景材质" /><TextBlock Text="{Binding BackdropDescription}" Style="{StaticResource SettingDescription}" ToolTip="{Binding BackdropDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="BackdropChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="AcrylicBackdrop" Content="亚克力" IsChecked="{Binding Backdrop, Converter={StaticResource Selection}, ConverterParameter=acrylic}" GroupName="Backdrop" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="MicaBackdrop" Content="云母" IsChecked="{Binding Backdrop, Converter={StaticResource Selection}, ConverterParameter=mica}" GroupName="Backdrop" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="SolidBackdrop" Content="纯色" IsChecked="{Binding Backdrop, Converter={StaticResource Selection}, ConverterParameter=solid}" GroupName="Backdrop" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="强调色" /><TextBlock Text="{Binding AccentDescription}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <StackPanel x:Name="AccentChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                    <RadioButton x:Name="SystemAccent" Content="跟随系统" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=system}" GroupName="Accent" Style="{StaticResource IconSizeSegment}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="BlueAccent" Background="#0067C0" ToolTip="蓝" AutomationProperties.Name="蓝" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=blue}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="TealAccent" Background="#038387" ToolTip="青" AutomationProperties.Name="青" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=teal}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="GreenAccent" Background="#107C10" ToolTip="绿" AutomationProperties.Name="绿" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=green}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="PurpleAccent" Background="#8764B8" ToolTip="紫" AutomationProperties.Name="紫" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=purple}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="MagentaAccent" Background="#C239B3" ToolTip="玫红" AutomationProperties.Name="玫红" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=magenta}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="OrangeAccent" Background="#CA5010" ToolTip="橙" AutomationProperties.Name="橙" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=orange}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="SlateAccent" Background="#69797E" ToolTip="石板灰" AutomationProperties.Name="石板灰" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=slate}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Grid24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="图标大小" /><TextBlock Text="调整面板中的图标和条目间距" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="IconSizes" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="SmallIcons" Content="小" Tag="32" IsChecked="{Binding IconSize, Converter={StaticResource Selection}, ConverterParameter=32}" GroupName="IconSize" Style="{StaticResource IconSizeSegment}" ToolTip="32 DIP" />
                        <RadioButton x:Name="MediumIcons" Content="中" Tag="40" IsChecked="{Binding IconSize, Converter={StaticResource Selection}, ConverterParameter=40}" GroupName="IconSize" Style="{StaticResource IconSizeSegment}" ToolTip="40 DIP" />
                        <RadioButton x:Name="LargeIcons" Content="大" Tag="48" IsChecked="{Binding IconSize, Converter={StaticResource Selection}, ConverterParameter=48}" GroupName="IconSize" Style="{StaticResource IconSizeSegment}" ToolTip="48 DIP" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="呼出位置" /><TextBlock Text="选择面板再次显示时的位置" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="Placements" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="LastPosition" Content="上次位置" Tag="lastPosition" IsChecked="{Binding Placement, Converter={StaticResource Selection}, ConverterParameter=lastPosition}" GroupName="Placement" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="FollowMouse" Content="跟随鼠标" Tag="cursor" IsChecked="{Binding Placement, Converter={StaticResource Selection}, ConverterParameter=cursor}" GroupName="Placement" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Globe24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="自动获取网站图标" /><TextBlock Text="直接联系网址所在的网站获取图标" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WebsiteIconsBox" IsChecked="{Binding AutoFetchWebsiteIcons}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="自动获取网站图标" />
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowReset24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="面板位置和大小" /><TextBlock Text="拖动顶栏移动，拖动边缘调整大小" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <ui:Button x:Name="ResetSizeButton" Content="恢复默认位置和大小" Command="{Binding ResetSizeCommand}" />
            </ui:CardControl>
            <TextBlock Text="启动" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,10" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Power24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="登录 Windows 时自动启动" /><TextBlock Text="启动后在系统托盘中待命" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupBox" AutomationProperties.Name="登录 Windows 时自动启动" IsChecked="{Binding StartupEnabled}">
                    <ui:ToggleSwitch.Style><Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                        <Setter Property="IsEnabled" Value="{Binding CanEdit}" />
                        <Style.Triggers><DataTrigger Binding="{Binding StartupAvailable}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                    </Style></ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
            </ui:CardControl>
            <TextBox x:Name="DirectoryLabel" Text="{Binding DirectoryLabel, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="0,14,0,16"
                     Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="配置目录">
                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template>
            </TextBox>

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
