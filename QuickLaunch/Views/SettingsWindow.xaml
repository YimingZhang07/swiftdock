<Window x:Class="QuickLaunch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock Text="快捷键" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="呼出 / 隐藏面板" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="Alt" Content="Alt" Margin="0,0,16,0" />
            <CheckBox x:Name="Control" Content="Ctrl" Margin="0,0,16,0" />
            <CheckBox x:Name="Shift" Content="Shift" Margin="0,0,16,0" />
            <CheckBox x:Name="Windows" Content="Win" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="MainKey" Margin="0,0,8,0" AutomationProperties.Name="主键" />
            <Button x:Name="ApplyButton" Grid.Column="1" Content="应用" Style="{StaticResource AccentButton}" Click="ApplyClick" />
        </Grid>
        <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,12" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="图标大小" FontSize="13" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                <StackPanel x:Name="IconSizes" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                    <RadioButton x:Name="SmallIcons" Content="小" Tag="32" GroupName="IconSize" Style="{StaticResource IconSizeSegment}" Checked="IconSizeChanged" ToolTip="32 DIP" />
                    <RadioButton x:Name="MediumIcons" Content="中" Tag="40" GroupName="IconSize" Style="{StaticResource IconSizeSegment}" Checked="IconSizeChanged" ToolTip="40 DIP" />
                    <RadioButton x:Name="LargeIcons" Content="大" Tag="48" GroupName="IconSize" Style="{StaticResource IconSizeSegment}" Checked="IconSizeChanged" ToolTip="48 DIP" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="呼出位置" FontSize="13" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                <StackPanel x:Name="Placements" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                    <RadioButton x:Name="LastPosition" Content="上次位置" Tag="lastPosition" GroupName="Placement" Style="{StaticResource IconSizeSegment}" Checked="PlacementChanged" />
                    <RadioButton x:Name="FollowMouse" Content="跟随鼠标" Tag="cursor" GroupName="Placement" Style="{StaticResource IconSizeSegment}" Checked="PlacementChanged" />
                </StackPanel>
            </Border>
        </Grid>
        <CheckBox x:Name="WebsiteIconsBox" Content="自动获取网站图标" Margin="0,0,0,12" Click="WebsiteIconsClick"
                  ToolTip="直接联系网址所在的网站获取图标" />
        <Button x:Name="ResetSizeButton" Content="恢复默认位置和大小" HorizontalAlignment="Left" Click="ResetSizeClick" />
        <TextBlock Text="拖动顶栏移动，拖动边缘调整大小" Foreground="{DynamicResource TertiaryBrush}" FontSize="12" Margin="0,8,0,0" />
        <TextBlock Text="启动" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,12" />
        <CheckBox x:Name="StartupBox" Content="登录 Windows 时自动启动" Click="StartupClick" />
        <TextBlock x:Name="Result" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,20,0,16" />
        <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="0,0,0,16" />
        <TextBox x:Name="DirectoryLabel" IsReadOnly="True" TextWrapping="Wrap" Foreground="{DynamicResource TertiaryBrush}" FontSize="11" Margin="0,0,0,16"
                 Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="配置目录">
            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template>
        </TextBox>
        <Grid>
            <Button x:Name="ExitButton" Content="退出 QuickLaunch" Foreground="{DynamicResource ErrorBrush}" HorizontalAlignment="Left" Click="ExitClick" />
            <Button Content="关闭" HorizontalAlignment="Right" Click="CloseClick" IsCancel="True" />
        </Grid>
    </StackPanel>
</Window>
