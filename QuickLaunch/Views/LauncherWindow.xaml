<Window x:Class="QuickLaunch.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickLaunch" Width="620" Height="500" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" AllowDrop="True">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="TilePanel"><WrapPanel ItemWidth="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=Window}}" ItemHeight="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate>
        <ContextMenu x:Key="ItemContextMenu" Opened="ItemMenuOpened" Closed="ItemMenuClosed">
            <MenuItem Header="打开" Click="OpenMenuClick" />
            <MenuItem Header="以管理员身份运行" Click="AdminMenuClick" />
            <MenuItem Header="打开所在位置" Click="LocationMenuClick" />
            <MenuItem Header="编辑…" Tag="edit" Click="EditMenuClick" />
            <MenuItem Header="重命名" Tag="edit" Click="RenameMenuClick" />
            <MenuItem Header="删除" Tag="edit" Click="DeleteMenuClick" />
            <Separator /><MenuItem Header="刷新图标" Click="RefreshIconMenuClick" />
        </ContextMenu>
        <DataTemplate x:Key="TileTemplate">
            <Button x:Name="TileButton" Width="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=Window}}" Padding="3" Opacity="0.7" ToolTip="{Binding ToolTip}" Click="ItemClick"
                    AutomationProperties.Name="{Binding Name}" ContextMenu="{StaticResource ItemContextMenu}">
                <StackPanel>
                    <Grid Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Image Source="{Binding Visual.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="TileGlyph" Text="{Binding Glyph}" FontSize="28" Foreground="#F28B82" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Border x:Name="ErrorBadge" Background="{DynamicResource ErrorBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="!" Foreground="White" FontSize="10" TextAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Visual.Image}" Value="{x:Null}">
                    <Setter TargetName="TileGlyph" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter TargetName="ErrorBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TileButton" Property="Opacity" Value="1" />
                    <Setter TargetName="TileGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True"><Setter TargetName="TileButton" Property="IsEnabled" Value="False" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid x:Name="Root" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="添加" Click="AddItemClick" IsEnabled="{Binding CanEdit}" />
                    <Button Content="设置" Click="SettingsClick" />
                    <Button Content="隐藏" Click="HideClick" /><Button Content="退出" Click="ExitClick" />
                </StackPanel>
                <Border x:Name="WindowDragArea" Background="Transparent" Cursor="SizeAll"
                        ToolTip="拖动此处移动窗口" MouseLeftButtonDown="WindowDragMouseDown">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QuickLaunch" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StorageStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="AddGroupButton" DockPanel.Dock="Right" Content="+" ToolTip="新建分组；也可拖动条目到此处" Click="AddGroupClick" IsEnabled="{Binding CanEdit}" />
                <ScrollViewer x:Name="TabsViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
            <ScrollViewer x:Name="Viewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="GroupHost" MinHeight="100" Background="Transparent" />
            </ScrollViewer>
            <Border x:Name="Insertion" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="3" Height="78" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <CheckBox x:Name="KeepVisible" Content="保持显示以添加：从资源管理器或浏览器拖入" Foreground="{DynamicResource MutedBrush}" Margin="4,4,0,8" />
                <Button x:Name="CancelImportButton" Content="取消导入" Click="CancelImportClick" Visibility="Collapsed" HorizontalAlignment="Left" />
                <TextBlock x:Name="Status" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="12" Margin="4,0" />
            </StackPanel>
            <TextBlock Grid.Row="4" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="4,12,0,0" TextWrapping="Wrap">
                <Run Text="{Binding HotkeyDisplay, Mode=OneWay}" /><Run Text=" 呼出 / 隐藏    ·    Enter 启动    ·    Esc 取消" />
            </TextBlock>
            <Canvas Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True">
                <Border x:Name="Ghost" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Opacity="0.85" Padding="10" CornerRadius="8" Visibility="Collapsed">
                    <Border.RenderTransform><ScaleTransform ScaleX="1.1" ScaleY="1.1" /></Border.RenderTransform>
                    <StackPanel Orientation="Horizontal"><Image x:Name="GhostImage" Width="40" Height="40" Margin="0,0,8,0" /><TextBlock x:Name="GhostText" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" /></StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
