<Window x:Class="QuickLaunch.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickLaunch.Views"
        xmlns:services="clr-namespace:QuickLaunch.Services"
        xmlns:gong="urn:gong-wpf-dragdrop"
        xmlns:drop="clr-namespace:QuickLaunch.DragDrop"
        Title="QuickLaunch" Width="620" Height="500" WindowStyle="None"
        ResizeMode="CanResize" AllowsTransparency="False" ShowInTaskbar="False" Topmost="{Binding State.AlwaysOnTop, Mode=OneWay}"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" Focusable="False" FocusVisualStyle="{x:Null}">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6" CaptionHeight="0" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:GroupSelectionConverter x:Key="GroupSelection" />
        <local:TabInsetConverter x:Key="TabInset" />
        <drop:LauncherDropInfoBuilder x:Key="LauncherDropInfo" />
        <Pen x:Key="DropInsertionPen" Brush="{DynamicResource AccentFillColorDefaultBrush}" Thickness="3" />
        <DataTemplate x:Key="TileDragAdorner">
            <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="1" Opacity="0.85" Padding="10" CornerRadius="8">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1" /></Setter.Value></Setter>
                    <Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False">
                        <Setter Property="RenderTransform" Value="{x:Static Transform.Identity}" />
                    </DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Visual.Image}" Width="40" Height="40" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GroupDragAdorner">
            <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="1" Opacity="0.85" Padding="10" CornerRadius="8">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </DataTemplate>
        <Style TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="Thumb">
            <Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="IconButton" TargetType="{x:Type ButtonBase}">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinIconButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <!-- Pin / Unpin exist in both Segoe Fluent Icons and Segoe MDL2 Assets. -->
            <Setter Property="Content" Value="&#xE77A;" />
            <Setter Property="ToolTip" Value="置顶" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE718;" />
                    <Setter Property="ToolTip" Value="取消置顶" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddGroupIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="gong:DragDrop.IsDragSource" Value="True" />
            <Setter Property="gong:DragDrop.DragHandler" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="gong:DragDrop.DragAdornerTemplate" Value="{StaticResource GroupDragAdorner}" />
            <Setter Property="gong:DragDrop.UseDefaultEffectDataTemplate" Value="False" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="10,6" /><Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Normal" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,3" />
                            </Border>
                            <Border x:Name="Underline" Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="local:TabState.IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToastLink" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="10,0,0,0" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center" /></Border>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <ItemsPanelTemplate x:Key="TilePanel"><local:TilePanel ItemWidth="{Binding DataContext.State.CellSize, RelativeSource={RelativeSource AncestorType=Window}}" ItemHeight="{Binding DataContext.State.CellSize, RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate>
        <ContextMenu x:Key="ItemContextMenu" Opened="ItemMenuOpened" Closed="ItemMenuClosed"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="打开" Command="{Binding LaunchCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="以管理员身份运行" Command="{Binding LaunchElevatedCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="打开所在位置" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="编辑…" Tag="edit" Command="{Binding EditCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="更换图标…" Tag="edit" Command="{Binding ChangeIconCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="重命名" Tag="edit" Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="删除" Tag="edit" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator /><MenuItem Header="刷新图标" Command="{Binding RefreshIconCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <Style x:Key="TileList" TargetType="local:TileListBox">
            <Setter Property="gong:DragDrop.DropInfoBuilder" Value="{StaticResource LauncherDropInfo}" />
            <Setter Property="gong:DragDrop.IsDragSource" Value="True" /><Setter Property="gong:DragDrop.IsDropTarget" Value="True" />
            <Setter Property="gong:DragDrop.DragHandler" Value="{Binding}" /><Setter Property="gong:DragDrop.DropHandler" Value="{Binding}" />
            <Setter Property="gong:DragDrop.DragAdornerTemplate" Value="{StaticResource TileDragAdorner}" />
            <Setter Property="gong:DragDrop.DropTargetAdornerPen" Value="{StaticResource DropInsertionPen}" />
            <Setter Property="gong:DragDrop.UseDefaultEffectDataTemplate" Value="False" />
            <Setter Property="gong:DragDrop.ShowAlwaysDropTargetAdorner" Value="True" />
            <Setter Property="gong:DragDrop.DragDirectlySelectedOnly" Value="True" />
            <Setter Property="gong:DragDrop.DropTargetScrollViewer" Value="{Binding ElementName=Viewer}" />
            <Setter Property="SelectionMode" Value="Single" /><Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:TileListBox">
                <Border Background="{TemplateBinding Background}"><ItemsPresenter /></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TileItem" TargetType="local:TileListBoxItem">
            <Setter Property="Width" Value="{Binding DataContext.State.TileSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.State.TileSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="2" /><Setter Property="Padding" Value="4" /><Setter Property="Opacity" Value="0.55" />
            <Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" /><Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:TileListBoxItem">
                <Grid>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Width="{Binding DataContext.State.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.State.IconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Image Source="{Binding Visual.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="TileGlyph" Text="{Binding Glyph}" FontSize="{Binding DataContext.State.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Ellipse x:Name="ErrorBadge" Fill="{DynamicResource SystemFillColorCriticalBrush}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock x:Name="TileLabel" Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       LineHeight="14" LineStackingStrategy="BlockLineHeight" Height="28" TextAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SelectionRing" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" BorderThickness="2" CornerRadius="6"
                            IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Visual.Image}" Value="{x:Null}"><Setter TargetName="TileGlyph" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                        <Setter TargetName="ErrorBadge" Property="Visibility" Value="Collapsed" /><Setter Property="Opacity" Value="1" />
                        <Setter TargetName="TileGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                        <Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.5" />
                        <Setter TargetName="ErrorBadge" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Background="{DynamicResource ApplicationBackgroundBrush}" Focusable="False">
        <Grid.RowDefinitions><RowDefinition Height="{x:Static services:WindowPlacement.HeaderRowHeight}" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="WindowDragArea" Background="Transparent" Padding="16,0" Focusable="False">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="StorageNotice" Text="{Binding State.StorageWarning}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                               MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip="{Binding State.StorageWarning}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding State.StorageWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="AddItemButton" Style="{StaticResource IconButton}" Content="&#xECC8;" ToolTip="添加项目（也可拖入文件）" AutomationProperties.Name="添加项目" Command="{Binding AddItemCommand}" IsEnabled="{Binding CanEdit}" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" Click="SettingsClick" />
                    <ToggleButton x:Name="PinButton" Style="{StaticResource PinIconButton}" AutomationProperties.Name="置顶" AutomationProperties.AutomationId="PinButton"
                                  IsChecked="{Binding State.AlwaysOnTop, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                    <Button x:Name="HidePanelButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" AutomationProperties.Name="隐藏面板" Command="{Binding HidePanelCommand}"
                            ToolTip="{Binding State.HotkeyDisplay, StringFormat=隐藏 (Esc)  ·  {0} 呼出}" />
                </StackPanel>
                <ScrollViewer x:Name="TabsViewport" DockPanel.Dock="Left" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabsMouseWheel" VerticalAlignment="Center">
                    <ScrollViewer.Margin><MultiBinding Converter="{StaticResource TabInset}">
                        <Binding ElementName="GroupHost" Path="ActualWidth" /><Binding Path="State.CellSize" /><Binding Path="State.IconSize" />
                    </MultiBinding></ScrollViewer.Margin>
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="Tabs" ItemsSource="{Binding Groups}" Focusable="False"
                                      gong:DragDrop.DropInfoBuilder="{StaticResource LauncherDropInfo}"
                                      gong:DragDrop.IsDropTarget="True" gong:DragDrop.DropHandler="{Binding}"
                                      gong:DragDrop.DropTargetAdornerPen="{StaticResource DropInsertionPen}"
                                      gong:DragDrop.DropTargetScrollViewer="{Binding ElementName=TabsViewport}"
                                      gong:DragDrop.UseDefaultEffectDataTemplate="False" gong:DragDrop.DragDirectlySelectedOnly="True">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <local:GroupTabButton Style="{StaticResource TabButton}" Content="{Binding Name}" ToolTip="{Binding Name}" Tag="{Binding}"
                                        MaxWidth="190" Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" PreviewMouseDoubleClick="TabDoubleClick" Loaded="TabLoaded">
                                    <local:TabState.IsSelected><MultiBinding Converter="{StaticResource GroupSelection}">
                                        <Binding /><Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding></local:TabState.IsSelected>
                                </local:GroupTabButton>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddGroupButton" Style="{StaticResource AddGroupIconButton}" Content="&#xE710;" FontSize="12" ToolTip="新建分组；也可把条目拖到这里"
                                AutomationProperties.Name="新建分组" Click="AddGroupClick" IsEnabled="{Binding CanEdit}"
                                gong:DragDrop.IsDropTarget="True" gong:DragDrop.DropHandler="{Binding NewGroupDropTarget}"
                                gong:DragDrop.DropInfoBuilder="{StaticResource LauncherDropInfo}"
                                gong:DragDrop.DropTargetAdornerPen="{StaticResource DropInsertionPen}" />
                    </StackPanel>
                </ScrollViewer>
                <Border Background="Transparent" />
            </DockPanel>
        </Border>
        <Border Height="1" Margin="16,0" VerticalAlignment="Bottom" Background="{DynamicResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" />
        <Grid Grid.Row="1" Margin="{x:Static services:WindowPlacement.ContentMargin}" ClipToBounds="True">
            <ScrollViewer x:Name="Viewer" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="IconsMouseWheel">
                <Grid x:Name="GroupHost" Background="Transparent" Focusable="False" />
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedGroup.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                <TextBlock Text="拖入文件、文件夹或网址" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" FontSize="13" />
                <TextBlock Text="或点击右上角添加项目" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" VerticalAlignment="Bottom" Height="{x:Static services:WindowPlacement.BottomPadding}" Margin="16,0" ClipToBounds="True">
            <local:ToastSurface x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
                <DockPanel>
                    <Button x:Name="CancelImportButton" DockPanel.Dock="Right" Style="{StaticResource ToastLink}" FontSize="12" Content="取消" AutomationProperties.Name="取消导入"
                            Command="{Binding CancelImportCommand}" Visibility="{Binding Importing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="Status" Text="{Binding ToastText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="12" IsHitTestVisible="False" />
                </DockPanel>
            </local:ToastSurface>
        </Grid>
    </Grid>
</Window>
