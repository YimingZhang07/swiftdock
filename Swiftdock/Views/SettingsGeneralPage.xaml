<views:SettingsPage x:Class="Swiftdock.Views.SettingsGeneralPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Swiftdock.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Swiftdock.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <views:SettingsPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsResources.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></views:SettingsPage.Resources>
    <ScrollViewer x:Name="PageScroll" Margin="16,12,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="0,0,0,4">
            <TextBlock Text="{loc:Loc General}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsGeneralTitle" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="LocalLanguage24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><TextBlock Text="{loc:Loc Language}" AutomationProperties.AutomationId="LanguageLabel" /></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="LanguageChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="SystemLanguage" AutomationProperties.AutomationId="SystemLanguage" Content="{loc:Loc FollowSystem}" IsChecked="{Binding Language, Converter={StaticResource Selection}, ConverterParameter=system}" GroupName="Language" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="ChineseLanguage" AutomationProperties.AutomationId="ChineseLanguage" Content="{loc:Loc Chinese}" IsChecked="{Binding Language, Converter={StaticResource Selection}, ConverterParameter=zh-CN}" GroupName="Language" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="EnglishLanguage" AutomationProperties.AutomationId="EnglishLanguage" Content="{loc:Loc English}" IsChecked="{Binding Language, Converter={StaticResource Selection}, ConverterParameter=en}" GroupName="Language" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl HorizontalContentAlignment="Stretch">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc ShowHidePanel}" />
                        <TextBlock x:Name="Result" Text="{Binding Status}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescription}">
                                <Style.Triggers><DataTrigger Binding="{Binding StatusError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox MinWidth="0" x:Name="Alt" IsChecked="{Binding Alt}" IsEnabled="{Binding CanEdit}" Content="Alt" Margin="0,0,4,0" />
                            <CheckBox MinWidth="0" x:Name="Control" IsChecked="{Binding Control}" IsEnabled="{Binding CanEdit}" Content="Ctrl" Margin="0,0,4,0" />
                            <CheckBox MinWidth="0" x:Name="Shift" IsChecked="{Binding Shift}" IsEnabled="{Binding CanEdit}" Content="Shift" Margin="0,0,4,0" />
                            <CheckBox MinWidth="0" x:Name="Windows" IsChecked="{Binding Windows}" IsEnabled="{Binding CanEdit}" Content="Win" Margin="0,0,4,0" />
                            <ComboBox x:Name="MainKey" ItemsSource="{Binding Keys}" SelectedItem="{Binding MainKey}" IsEnabled="{Binding CanEdit}" MinWidth="112" Margin="0,0,8,0" AutomationProperties.Name="{loc:Loc MainKey}" />
                            <ui:Button x:Name="ApplyButton" Content="{loc:Loc Apply}" Appearance="Primary" Command="{Binding ApplyCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Power24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc StartWhenSigningInToWindows}" /><TextBlock Text="{loc:Loc WaitInTheSystemTrayAfterStartup}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupBox" AutomationProperties.Name="{loc:Loc StartWhenSigningInToWindows}" IsChecked="{Binding StartupEnabled}">
                    <ui:ToggleSwitch.Style><Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                        <Setter Property="IsEnabled" Value="{Binding CanEdit}" />
                        <Style.Triggers><DataTrigger Binding="{Binding StartupAvailable}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                    </Style></ui:ToggleSwitch.Style>
                </ui:ToggleSwitch>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="SignOut24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><TextBlock Text="{loc:Loc ExitSwiftdock}" /></ui:CardControl.Header>
                <ui:Button x:Name="ExitButton" Content="{loc:Loc ExitSwiftdock}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Command="{Binding ExitCommand}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</views:SettingsPage>
