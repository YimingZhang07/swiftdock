<views:SettingsPage x:Class="Swiftdock.Views.SettingsAboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Swiftdock.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Swiftdock.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <views:SettingsPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsResources.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></views:SettingsPage.Resources>
    <ScrollViewer x:Name="PageScroll" Margin="16,12,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="0,0,0,4">
            <TextBlock Text="{loc:Loc About}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsAboutTitle" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Info24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><TextBlock Text="{loc:Loc Version}" /></ui:CardControl.Header>
                <TextBlock x:Name="AppVersionLabel" Text="{Binding AppVersion}" />
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Folder24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc ConfigurationFolder}" />
                        <TextBox x:Name="DirectoryLabel" Text="{Binding DirectoryLabel, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,8,0,0"
                                 Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="{loc:Loc ConfigurationFolder}">
                            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" /></ControlTemplate></TextBox.Template>
                        </TextBox>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="DocumentText24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><TextBlock Text="{loc:Loc DiagnosticLogs}" /></ui:CardControl.Header>
                <ui:Button x:Name="OpenLogsButton" Content="{loc:Loc OpenLogFolder}" Command="{Binding OpenLogsCommand}" />
            </ui:CardControl>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SettingDescription}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding StatusError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</views:SettingsPage>
