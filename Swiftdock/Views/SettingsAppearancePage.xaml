<views:SettingsPage x:Class="Swiftdock.Views.SettingsAppearancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Swiftdock.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Swiftdock.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <views:SettingsPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsResources.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></views:SettingsPage.Resources>
    <ScrollViewer x:Name="PageScroll" Margin="16,12,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="0,0,0,4">
            <TextBlock Text="{loc:Loc Appearance}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsAppearanceTitle" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="WeatherMoon24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc Theme}" /><TextBlock Text="{Binding ThemeDescription}" Style="{StaticResource SettingDescription}" ToolTip="{Binding ThemeDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="ThemeChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="SystemTheme" Content="{loc:Loc FollowSystem}" IsChecked="{Binding Theme, Converter={StaticResource Selection}, ConverterParameter=system}" GroupName="Theme" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="LightTheme" Content="{loc:Loc Light}" IsChecked="{Binding Theme, Converter={StaticResource Selection}, ConverterParameter=light}" GroupName="Theme" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="DarkTheme" Content="{loc:Loc Dark}" IsChecked="{Binding Theme, Converter={StaticResource Selection}, ConverterParameter=dark}" GroupName="Theme" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc BackgroundMaterial}" /><TextBlock Text="{Binding BackdropDescription}" Style="{StaticResource SettingDescription}" ToolTip="{Binding BackdropDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="BackdropChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="AcrylicBackdrop" Content="{loc:Loc Acrylic}" IsChecked="{Binding Backdrop, Converter={StaticResource Selection}, ConverterParameter=acrylic}" GroupName="Backdrop" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="MicaBackdrop" Content="{loc:Loc Mica}" IsChecked="{Binding Backdrop, Converter={StaticResource Selection}, ConverterParameter=mica}" GroupName="Backdrop" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="SolidBackdrop" Content="{loc:Loc Solid}" IsChecked="{Binding Backdrop, Converter={StaticResource Selection}, ConverterParameter=solid}" GroupName="Backdrop" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <StackPanel Margin="44,0,0,6" IsEnabled="{Binding CanEditBackdrop}">
                <Grid MinHeight="36">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Transparency}" VerticalAlignment="Center" />
                    <Slider x:Name="TransparencySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            SmallChange="5" LargeChange="10" VerticalAlignment="Center" Value="{Binding Transparency, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{loc:Loc Transparency}" />
                    <TextBlock Grid.Column="2" Text="{Binding Transparency, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid MinHeight="36">
                    <TextBlock Text="{loc:Loc KeepTransparencyWhenInactive}" VerticalAlignment="Center" />
                    <ui:ToggleSwitch x:Name="KeepBackdropWhenInactiveBox" IsChecked="{Binding KeepBackdropWhenInactive}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{loc:Loc KeepTransparencyWhenInactive}" />
                </Grid>
            </StackPanel>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc AccentColor}" /><TextBlock Text="{Binding AccentDescription}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <StackPanel x:Name="AccentChoices" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                    <RadioButton x:Name="SystemAccent" Content="{loc:Loc FollowSystem}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=system}" GroupName="Accent" Style="{StaticResource IconSizeSegment}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="BlueAccent" Background="#0067C0" ToolTip="{loc:Loc Blue}" AutomationProperties.Name="{loc:Loc Blue}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=blue}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="TealAccent" Background="#038387" ToolTip="{loc:Loc Teal}" AutomationProperties.Name="{loc:Loc Teal}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=teal}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="GreenAccent" Background="#107C10" ToolTip="{loc:Loc Green}" AutomationProperties.Name="{loc:Loc Green}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=green}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="PurpleAccent" Background="#8764B8" ToolTip="{loc:Loc Purple}" AutomationProperties.Name="{loc:Loc Purple}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=purple}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="MagentaAccent" Background="#C239B3" ToolTip="{loc:Loc Magenta}" AutomationProperties.Name="{loc:Loc Magenta}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=magenta}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="OrangeAccent" Background="#CA5010" ToolTip="{loc:Loc Orange}" AutomationProperties.Name="{loc:Loc Orange}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=orange}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                    <RadioButton x:Name="SlateAccent" Background="#69797E" ToolTip="{loc:Loc Slate}" AutomationProperties.Name="{loc:Loc Slate}" IsChecked="{Binding Accent, Converter={StaticResource Selection}, ConverterParameter=slate}" GroupName="Accent" Style="{StaticResource AccentSwatch}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Grid24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc Scale}" /><TextBlock Text="{loc:Loc AdjustPanelIconsTextAndSpacing}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <Grid IsEnabled="{Binding CanEdit}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <Slider x:Name="ScaleSlider" Minimum="80" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True"
                            SmallChange="10" LargeChange="20" VerticalAlignment="Center" Value="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{loc:Loc Scale}" />
                    <TextBlock Grid.Column="1" Text="{Binding Scale, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</views:SettingsPage>
