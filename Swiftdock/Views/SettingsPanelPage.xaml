<views:SettingsPage x:Class="Swiftdock.Views.SettingsPanelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Swiftdock.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Swiftdock.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <views:SettingsPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SettingsResources.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></views:SettingsPage.Resources>
    <ScrollViewer x:Name="PageScroll" Margin="16,12,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="0,0,0,4">
            <TextBlock Text="{loc:Loc Panel}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" AutomationProperties.AutomationId="SettingsPanelTitle" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc ShowPosition}" /><TextBlock Text="{loc:Loc PositionWhenThePanelIsShownAgain}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel x:Name="Placements" IsEnabled="{Binding CanEdit}" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle" PreviewKeyDown="SegmentKeyDown">
                        <RadioButton x:Name="LastPosition" Content="{loc:Loc LastPosition}" Tag="lastPosition" IsChecked="{Binding Placement, Converter={StaticResource Selection}, ConverterParameter=lastPosition}" GroupName="Placement" Style="{StaticResource IconSizeSegment}" />
                        <RadioButton x:Name="FollowMouse" Content="{loc:Loc FollowPointer}" Tag="cursor" IsChecked="{Binding Placement, Converter={StaticResource Selection}, ConverterParameter=cursor}" GroupName="Placement" Style="{StaticResource IconSizeSegment}" />
                    </StackPanel>
                </Border>
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowReset24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc PanelPositionAndSize}" /><TextBlock Text="{loc:Loc DragTheTitleBarToMoveEdgesToResize}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <ui:Button x:Name="ResetSizeButton" Content="{loc:Loc ResetPositionAndSize}" Command="{Binding ResetSizeCommand}" />
            </ui:CardControl>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Globe24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><StackPanel><TextBlock Text="{loc:Loc AutoFetchWebsiteIcons}" /><TextBlock Text="{loc:Loc ContactEachWebsiteDirectlyForItsIcon}" Style="{StaticResource SettingDescription}" /></StackPanel></ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="WebsiteIconsBox" IsChecked="{Binding AutoFetchWebsiteIcons}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{loc:Loc AutoFetchWebsiteIcons}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</views:SettingsPage>
