<ui:FluentWindow x:Class="Swiftdock.Views.NameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}" Width="380" MinWidth="0" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <DockPanel>
    <ui:TitleBar x:Name="DialogTitleBar" DockPanel.Dock="Top" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                 Icon="{x:Null}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />
    <StackPanel Margin="24,12,24,24">
        <TextBlock Text="名称" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
        <ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" PlaceholderText="名称" MaxLength="100" Margin="0,0,0,16" AutomationProperties.Name="名称" />
        <TextBlock x:Name="Error" Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="确定" Appearance="Primary" IsDefault="True" Command="{Binding AcceptCommand}" Margin="0,0,8,0" /><ui:Button Content="取消" IsCancel="True" />
        </StackPanel>
    </StackPanel>
    </DockPanel>
</ui:FluentWindow>
