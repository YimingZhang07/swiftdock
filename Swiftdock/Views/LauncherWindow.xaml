<Window x:Class="Swiftdock.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:Swiftdock.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Swiftdock.Views"
        xmlns:gong="urn:gong-wpf-dragdrop"
        xmlns:drop="clr-namespace:Swiftdock.DragDrop"
        Title="{loc:Loc Swiftdock}" Width="620" Height="500" WindowStyle="None"
        ResizeMode="CanResize" AllowsTransparency="False" ShowInTaskbar="False" Topmost="{Binding State.AlwaysOnTop, Mode=OneWay}"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" Focusable="False" FocusVisualStyle="{x:Null}">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6" CaptionHeight="0" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <local:PanelResources x:Key="PanelMetrics" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:GroupSelectionConverter x:Key="GroupSelection" />
        <local:TabInsetConverter x:Key="TabInset" />
        <drop:LauncherDropInfoBuilder x:Key="LauncherDropInfo" />
        <Pen x:Key="DropInsertionPen" Brush="{DynamicResource AccentFillColorDefaultBrush}" Thickness="{Binding Source={StaticResource PanelMetrics}, Path=Length3}" />
        <DataTemplate x:Key="TileDragAdorner">
            <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="{Binding Source={StaticResource PanelMetrics}, Path=Inset1}" Opacity="0.85" Padding="{Binding Source={StaticResource PanelMetrics}, Path=Inset10}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius8}">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Visual.Image}" Width="{Binding Source={StaticResource PanelMetrics}, Path=Length40}" Height="{Binding Source={StaticResource PanelMetrics}, Path=Length40}" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset0_0_8_0}" />
                    <TextBlock FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GroupDragAdorner">
            <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    BorderThickness="{Binding Source={StaticResource PanelMetrics}, Path=Inset1}" Opacity="0.85" Padding="{Binding Source={StaticResource PanelMetrics}, Path=Inset10}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius8}">
                <TextBlock FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </DataTemplate>
        <Style TargetType="ScrollViewer">
            <Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="Thumb">
            <Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="IconButton" TargetType="{x:Type ButtonBase}">
            <Setter Property="Width" Value="{Binding Source={StaticResource PanelMetrics}, Path=Length32}" /><Setter Property="Height" Value="{Binding Source={StaticResource PanelMetrics}, Path=Length32}" />
            <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{Binding Source={StaticResource PanelMetrics}, Path=Length14}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Grid>
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius4}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinIconButton" TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
            <!-- Pin / Unpin exist in both Segoe Fluent Icons and Segoe MDL2 Assets. -->
            <Setter Property="Content" Value="&#xE77A;" />
            <Setter Property="ToolTip" Value="{loc:Loc KeepOnTop}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xE718;" />
                    <Setter Property="ToolTip" Value="{loc:Loc Unpin}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddGroupIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="gong:DragDrop.IsDragSource" Value="True" />
            <Setter Property="gong:DragDrop.DragHandler" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="gong:DragDrop.DragAdornerTemplate" Value="{StaticResource GroupDragAdorner}" />
            <Setter Property="gong:DragDrop.UseDefaultEffectDataTemplate" Value="False" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{Binding Source={StaticResource PanelMetrics}, Path=Length13}" /><Setter Property="Padding" Value="{Binding Source={StaticResource PanelMetrics}, Path=Inset10_6}" /><Setter Property="Margin" Value="0" />
            <Setter Property="FontWeight" Value="Normal" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius4}" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset0_0_0_3}" />
                            </Border>
                            <Border x:Name="Underline" Width="{Binding Source={StaticResource PanelMetrics}, Path=Length14}" Height="{Binding Source={StaticResource PanelMetrics}, Path=Length3}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius1p5}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset0_0_0_2}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="local:TabState.IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToastLink" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="{Binding Source={StaticResource PanelMetrics}, Path=Inset10_0_0_0}" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center" /></Border>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <ItemsPanelTemplate x:Key="TilePanel"><local:TilePanel ItemWidth="{Binding DataContext.State.CellSize, RelativeSource={RelativeSource AncestorType=Window}}" ItemHeight="{Binding DataContext.State.CellSize, RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate>
        <ContextMenu x:Key="ItemContextMenu" Opened="ItemMenuOpened" Closed="ItemMenuClosed"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{loc:Loc Open}" Command="{Binding LaunchCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc RunAsAdministrator}" Command="{Binding LaunchElevatedCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc OpenFileLocation}" Command="{Binding OpenLocationCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc Edit}" Tag="edit" Command="{Binding EditCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc ChangeIcon327}" Tag="edit" Command="{Binding ChangeIconCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc Rename}" Tag="edit" Command="{Binding RenameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{loc:Loc Delete}" Tag="edit" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Command="{Binding DeleteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator /><MenuItem Header="{loc:Loc RefreshIcon}" Command="{Binding RefreshIconCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <Style x:Key="TileList" TargetType="local:TileListBox">
            <Setter Property="gong:DragDrop.DropInfoBuilder" Value="{StaticResource LauncherDropInfo}" />
            <Setter Property="gong:DragDrop.IsDragSource" Value="True" /><Setter Property="gong:DragDrop.IsDropTarget" Value="True" />
            <Setter Property="gong:DragDrop.DragHandler" Value="{Binding}" /><Setter Property="gong:DragDrop.DropHandler" Value="{Binding}" />
            <Setter Property="gong:DragDrop.DragAdornerTemplate" Value="{StaticResource TileDragAdorner}" />
            <Setter Property="gong:DragDrop.DropTargetAdornerPen" Value="{StaticResource DropInsertionPen}" />
            <Setter Property="gong:DragDrop.UseDefaultEffectDataTemplate" Value="False" />
            <Setter Property="gong:DragDrop.ShowAlwaysDropTargetAdorner" Value="True" />
            <Setter Property="gong:DragDrop.DragDirectlySelectedOnly" Value="True" />
            <Setter Property="gong:DragDrop.DropTargetScrollViewer" Value="{Binding ElementName=Viewer}" />
            <Setter Property="SelectionMode" Value="Single" /><Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:TileListBox">
                <Border Background="{TemplateBinding Background}"><ItemsPresenter /></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TileItem" TargetType="local:TileListBoxItem">
            <Setter Property="Width" Value="{Binding DataContext.State.TileSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding DataContext.State.TileSize, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="{Binding Source={StaticResource PanelMetrics}, Path=Inset2}" /><Setter Property="Padding" Value="{Binding Source={StaticResource PanelMetrics}, Path=Inset4}" /><Setter Property="Opacity" Value="0.55" />
            <Setter Property="Focusable" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip.Value}" /><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName.Value}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:TileListBoxItem">
                <Grid>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius6}" Padding="{TemplateBinding Padding}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Width="{Binding DataContext.State.IconSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.State.IconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Image x:Name="TileImage" Source="{Binding Visual.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="TileGlyph" Text="{Binding Glyph}" FontSize="{Binding DataContext.State.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Ellipse x:Name="ErrorBadge" Fill="{DynamicResource SystemFillColorCriticalBrush}" Width="{Binding Source={StaticResource PanelMetrics}, Path=Length8}" Height="{Binding Source={StaticResource PanelMetrics}, Path=Length8}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock x:Name="TileLabel" Text="{Binding DisplayName.Value}" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       LineHeight="{Binding Source={StaticResource PanelMetrics}, Path=Length14}" LineStackingStrategy="BlockLineHeight" Height="{Binding Source={StaticResource PanelMetrics}, Path=Length28}" TextAlignment="Center" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset0_6_0_0}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SelectionRing" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" BorderThickness="{Binding Source={StaticResource PanelMetrics}, Path=Inset2}" CornerRadius="{Binding Source={StaticResource PanelMetrics}, Path=Radius6}"
                            IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding Visual.Image}" Value="{x:Null}"><Setter TargetName="TileGlyph" Property="Visibility" Value="Visible" /></DataTrigger>
                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                        <Setter TargetName="ErrorBadge" Property="Visibility" Value="Collapsed" /><Setter Property="Opacity" Value="1" />
                        <Setter TargetName="TileGlyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                        <Setter Property="IsEnabled" Value="False" /><Setter Property="Opacity" Value="0.5" />
                        <Setter TargetName="ErrorBadge" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid TextElement.FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" x:Name="Root" Background="{DynamicResource ApplicationBackgroundBrush}" Focusable="False">
        <Grid.RowDefinitions><RowDefinition Height="{Binding Source={StaticResource PanelMetrics}, Path=HeaderRowHeight}" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="WindowDragArea" Background="Transparent" Padding="{Binding Source={StaticResource PanelMetrics}, Path=Inset16_0}" Focusable="False">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset8_0_0_0}">
                    <TextBlock x:Name="StorageNotice" Text="{Binding State.StorageWarning}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}"
                               MaxWidth="{Binding Source={StaticResource PanelMetrics}, Path=Length120}" TextTrimming="CharacterEllipsis" ToolTip="{Binding State.StorageWarning}" VerticalAlignment="Center" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset0_0_8_0}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding State.StorageWarning}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="AddItemButton" AutomationProperties.AutomationId="AddItemButton" Style="{StaticResource IconButton}" Content="&#xECC8;" ToolTip="{loc:Loc AddItemOrDropFiles}" AutomationProperties.Name="{loc:Loc AddItem}" Command="{Binding AddItemCommand}" IsEnabled="{Binding CanEdit}" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{loc:Loc Settings}" AutomationProperties.Name="{loc:Loc Settings}" Click="SettingsClick" />
                    <ToggleButton x:Name="PinButton" Style="{StaticResource PinIconButton}" AutomationProperties.Name="{loc:Loc KeepOnTop}" AutomationProperties.AutomationId="PinButton"
                                  IsChecked="{Binding State.AlwaysOnTop, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
                    <Button x:Name="HidePanelButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length10}" AutomationProperties.Name="{loc:Loc HidePanel}" Command="{Binding HidePanelCommand}"
                            ToolTip="{Binding HideTooltip}" />
                </StackPanel>
                <ScrollViewer x:Name="TabsViewport" DockPanel.Dock="Left" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabsMouseWheel" VerticalAlignment="Center">
                    <ScrollViewer.Margin><MultiBinding Converter="{StaticResource TabInset}">
                        <Binding ElementName="GroupHost" Path="ActualWidth" /><Binding Path="State.CellSize" /><Binding Path="State.IconSize" />
                    </MultiBinding></ScrollViewer.Margin>
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="Tabs" ItemsSource="{Binding Groups}" Focusable="False"
                                      gong:DragDrop.DropInfoBuilder="{StaticResource LauncherDropInfo}"
                                      gong:DragDrop.IsDropTarget="True" gong:DragDrop.DropHandler="{Binding}"
                                      gong:DragDrop.DropTargetAdornerPen="{StaticResource DropInsertionPen}"
                                      gong:DragDrop.DropTargetScrollViewer="{Binding ElementName=TabsViewport}"
                                      gong:DragDrop.UseDefaultEffectDataTemplate="False" gong:DragDrop.DragDirectlySelectedOnly="True">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <local:GroupTabButton Style="{StaticResource TabButton}" Content="{Binding Name}" ToolTip="{Binding Name}" Tag="{Binding}"
                                        MaxWidth="{Binding Source={StaticResource PanelMetrics}, Path=Length190}" Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" PreviewMouseDoubleClick="TabDoubleClick" Loaded="TabLoaded">
                                    <local:TabState.IsSelected><MultiBinding Converter="{StaticResource GroupSelection}">
                                        <Binding /><Binding Path="DataContext.SelectedGroup" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding></local:TabState.IsSelected>
                                </local:GroupTabButton>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddGroupButton" Style="{StaticResource AddGroupIconButton}" Content="&#xE710;" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" ToolTip="{loc:Loc CreateAGroupOrDropAnItemHere}"
                                AutomationProperties.Name="{loc:Loc CreateGroup}" Click="AddGroupClick" IsEnabled="{Binding CanEdit}"
                                gong:DragDrop.IsDropTarget="True" gong:DragDrop.DropHandler="{Binding NewGroupDropTarget}"
                                gong:DragDrop.DropInfoBuilder="{StaticResource LauncherDropInfo}"
                                gong:DragDrop.DropTargetAdornerPen="{StaticResource DropInsertionPen}" />
                    </StackPanel>
                </ScrollViewer>
                <Border Background="Transparent" />
            </DockPanel>
        </Border>
        <Border Height="{Binding Source={StaticResource PanelMetrics}, Path=Length1}" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset16_0}" VerticalAlignment="Bottom" Background="{DynamicResource DividerStrokeColorDefaultBrush}" IsHitTestVisible="False" />
        <Grid Grid.Row="1" Margin="{Binding Source={StaticResource PanelMetrics}, Path=ContentMargin}" ClipToBounds="True">
            <ScrollViewer x:Name="Viewer" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="IconsMouseWheel">
                <Grid x:Name="GroupHost" Background="Transparent" Focusable="False" />
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedGroup.Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                <TextBlock Text="{loc:Loc DropFilesFoldersOrUrlsHere}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length13}" />
                <TextBlock Text="{loc:Loc OrAddAnItemWithTheButtonAbove}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextAlignment="Center" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset0_6_0_0}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" VerticalAlignment="Bottom" Height="{Binding Source={StaticResource PanelMetrics}, Path=Length24}" Margin="{Binding Source={StaticResource PanelMetrics}, Path=Inset16_0}" ClipToBounds="True">
            <local:ToastSurface x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Opacity="0">
                <DockPanel>
                    <Button x:Name="CancelImportButton" DockPanel.Dock="Right" Style="{StaticResource ToastLink}" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" Content="{loc:Loc Cancel}" AutomationProperties.Name="{loc:Loc CancelImport}"
                            Command="{Binding CancelImportCommand}" Visibility="{Binding Importing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="Status" Text="{Binding ToastText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="{Binding Source={StaticResource PanelMetrics}, Path=Length12}" IsHitTestVisible="False" />
                </DockPanel>
            </local:ToastSurface>
        </Grid>
    </Grid>
</Window>
